# ─── Sanity CMS ─────────────────────────────────────────────────────────────
# The read client (src/lib/sanity/client.ts) reads the PUBLISHED dataset over
# the public CDN, so it needs no token — the dataset must therefore be public.
# When PROJECT_ID is unset, all content accessors return empty and the site
# still builds/renders from its fallbacks.
NEXT_PUBLIC_SANITY_PROJECT_ID=9nwz9xmi
NEXT_PUBLIC_SANITY_DATASET=production
# Reserved: NOT used by the current read client. Only needed if the client is
# later extended to read drafts or a private dataset.
SANITY_API_TOKEN=

# Shared secret for the /api/revalidate webhook. In production, send it via the
# Sanity webhook's "x-sanity-revalidate-secret" header (recommended). The
# "?secret=" query param is accepted only for local/manual testing.
SANITY_REVALIDATE_SECRET=your_revalidate_secret

# ─── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_TO_EMAIL=preacher@your-domain.com

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
