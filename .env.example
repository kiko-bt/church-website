# ==============================================================================
# Environment variables — church-website
# ==============================================================================
# Copy to `.env.local` for local development:  cp .env.example .env.local
# `.env.local` is gitignored and must NEVER be committed. Only this example file
# is committed.
#
# WHERE EACH VARIABLE LIVES
#   • Local dev  → your `.env.local`
#   • Vercel     → Project → Settings → Environment Variables (Production, and
#                  Preview if you want previews to render live content)
#
# PUBLIC vs SECRET
#   • NEXT_PUBLIC_*  → inlined into the browser bundle at BUILD time. Not secret.
#                      Safe to commit real values (they ship to every visitor).
#   • everything else → server-only. Treat as a SECRET. Never prefix a secret
#                      with NEXT_PUBLIC_ or it will be exposed to the client.
#
# Full reference: docs/deployment.md  (§ Environment Variables)
# ==============================================================================


# ─── Sanity CMS (read) ────────────────────────────────────────────────────────
# PUBLIC. The read client (src/lib/sanity/client.ts) reads the PUBLISHED dataset
# over Sanity's public CDN, so it needs NO token — the dataset must be public.
# When PROJECT_ID is unset, every content accessor returns empty/null and the
# site still builds and renders from its fallbacks (Sanity is optional locally).
# Set BOTH locally and in Vercel (Production + Preview).
NEXT_PUBLIC_SANITY_PROJECT_ID=9nwz9xmi
NEXT_PUBLIC_SANITY_DATASET=production


# ─── Revalidation webhook secret ──────────────────────────────────────────────
# SECRET. A shared password between the Sanity webhook and /api/revalidate.
# You generate this yourself — it is NOT issued by Sanity. Generate a 32–64 char
# random string once (e.g. `openssl rand -hex 32`) and use the SAME value in:
#   1. Vercel  → Environment Variable  SANITY_REVALIDATE_SECRET  (Production)
#   2. Sanity  → the webhook's custom header  x-sanity-revalidate-secret
# On publish, Sanity sends the header; the route 401s unless it matches.
# In PRODUCTION the secret is accepted ONLY via the header (the ?secret= query
# param is ignored there); locally, ?secret= also works for manual curl tests.
# Locally any value works — it is only checked if you hit the route by hand.
SANITY_REVALIDATE_SECRET=generate_a_long_random_string


# ─── Site URL ─────────────────────────────────────────────────────────────────
# PUBLIC. Base URL for canonical links, hreflang, Open Graph, robots & sitemap
# (no trailing slash). MUST be set per environment:
#   • local   → http://localhost:3000
#   • Vercel  → https://www.hristovoevangelie.org   (Production — the `www` host
#               is canonical; the apex redirects to it)
# NEXT_PUBLIC_* are inlined at BUILD time, so changing this in Vercel requires a
# REDEPLOY to take effect. If unset, siteConfig falls back to the production
# domain — but never leave it as localhost in Vercel (that leaks localhost into
# every canonical/OG/sitemap URL). Always set it locally too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Sanity API token (RESERVED — not used yet) ───────────────────────────────
# SECRET. NOT used by the current read client (public CDN reads need no token).
# Leave blank. Only required if the client is later extended to read drafts or a
# private dataset. If you ever add it, use a READ-only token — never a write or
# management token (see .claude/security-rules.md).
SANITY_API_TOKEN=


# ─── Resend (email) — powers the contact form ─────────────────────────────────
# The contact form (src/features/contact) sends its notification email through
# Resend via a server action. All THREE vars below must be set for sending to
# work; if any is missing the form fails gracefully (a generic error to the
# visitor, the real reason logged server-side) — it never crashes the page.
#
#   RESEND_API_KEY    SECRET. Create at https://resend.com → API Keys. Server-only.
#   RESEND_FROM_EMAIL SECRET-ish. The "From" address; MUST be on a domain you have
#                     verified in Resend (Resend → Domains), or sends are rejected.
#   RESEND_TO_EMAIL   The recipient — the church's real inbox. ALSO used as the
#                     public contact address shown on the site (ContactInfo),
#                     unless churchSettings.email is set in the CMS.
#
# To change who receives contact messages, change RESEND_TO_EMAIL (and redeploy).
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@your-verified-domain.org
RESEND_TO_EMAIL=church-inbox@example.com
