{
  "name": "church-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run bible:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\" \"sanity/**/*.test.ts\"",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "bible:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-bible-artifacts.ts && npm run bible:validate",
    "bible:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-bible.ts",
    "health-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/health-check.ts"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^7.23.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.2",
    "sanity": "^6.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
